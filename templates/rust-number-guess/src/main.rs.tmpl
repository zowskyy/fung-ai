use std::io::{self, Write};
use std::time::{SystemTime, UNIX_EPOCH};

const PLAYER_NAME: &str = "{{player_name}}";
const WIN_EMOJI: &str = "{{win_emoji}}";
const DIFFICULTY: &str = "{{difficulty}}";

fn main() {
    let (range, max_guesses) = match DIFFICULTY {
        "easy" => (50, 10),
        "hard" => (200, 5),
        _ => (100, 7),
    };

    let seed = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|d| d.as_nanos() as u32)
        .unwrap_or(0);
    let secret = (seed % range) + 1;

    println!("🎲  Welcome, {}!  🎲", PLAYER_NAME);
    println!(
        "I'm thinking of a number between 1 and {}. You have {} guesses.",
        range, max_guesses
    );
    println!("Type your guess and press Enter.\n");

    let mut guesses: u32 = 0;
    loop {
        if guesses >= max_guesses {
            println!(
                "\nGame over! The number was {}. Better luck next time!",
                secret
            );
            break;
        }

        print!("Your guess (1-{}): ", range);
        io::stdout().flush().unwrap();

        let mut input = String::new();
        io::stdin().read_line(&mut input).expect("Failed to read line");

        let guess: u32 = match input.trim().parse() {
            Ok(num) => num,
            Err(_) => {
                println!("Please enter a valid number between 1 and {}!", range);
                continue;
            }
        };

        guesses += 1;

        if guess < secret {
            println!("Higher! 🔺  ({}/{} guesses used)", guesses, max_guesses);
        } else if guess > secret {
            println!("Lower! 🔻  ({}/{} guesses used)", guesses, max_guesses);
        } else {
            println!(
                "\n{}  Congratulations, {}!  {}  You got it in {} guesses!",
                WIN_EMOJI, PLAYER_NAME, WIN_EMOJI, guesses
            );
            break;
        }
    }
}
