[gd_resource type="Resource" script_class="ScenePlan" load_steps=4 format=3]

[ext_resource type="Script" path="res://addons/scene_animator/data/scene_plan.gd" id="1_plan"]
[ext_resource type="Script" path="res://addons/scene_animator/data/beats/dialogue_beat.gd" id="2_dialogue"]

[sub_resource type="Resource" id="Resource_bad_target"]
script = ExtResource("2_dialogue")
beat_id = &"bad_target"
speaker_actor_id = &"hero"
target_actor_id = &"phantom"
dialogue_id = &"line_phantom"

[resource]
script = ExtResource("1_plan")
plan_id = &"invalid_unknown_target"
display_name = "Invalid: Unknown Target"
beats = Array[Resource]([SubResource("Resource_bad_target")])
