[gd_resource type="Resource" script_class="ScenePlan" load_steps=4 format=3]

[ext_resource type="Script" path="res://addons/scene_animator/data/scene_plan.gd" id="1_plan"]
[ext_resource type="Script" path="res://addons/scene_animator/data/scene_actor_binding.gd" id="2_actor"]
[ext_resource type="Script" path="res://addons/scene_animator/data/beats/dialogue_beat.gd" id="3_dialogue"]

[sub_resource type="Resource" id="Resource_hero"]
script = ExtResource("2_actor")
actor_id = &"hero"
display_name = "Hero"
actor_tags = Array[StringName](["protagonist"])

[sub_resource type="Resource" id="Resource_opening"]
script = ExtResource("3_dialogue")
beat_id = &"opening"
speaker_actor_id = &"hero"
target_actor_id = &""
dialogue_id = &"opening_line"
next_beat_id = &""

[resource]
script = ExtResource("1_plan")
plan_id = &"starter_plan"
display_name = "Starter Scene Plan"
actors = Array[Resource]([SubResource("Resource_hero")])
beats = Array[Resource]([SubResource("Resource_opening")])
