; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="FungCaveProof"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon=""

[display]

window/size/viewport_width=1600
window/size/viewport_height=1600
window/stretch/mode="disabled"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/animation_engine_dock/plugin.cfg", "res://addons/scene_animator/plugin.cfg", "res://addons/character_animator/plugin.cfg")
