    },

    {
      "type": "dialogue", "beat_id": "s05_04_line1", "display_name": "5.04 'The law doesn't respect me.'",
      "dialogue_id": "nsb_s05_pure_02", "speaker_actor_id": "pure",
      "timeout_seconds": 8.0,
      "note": "\"The law doesn't respect me. But I'm not going to let that break me.\" Camera stays close_hold from s05_03_receive -- no new camera beat, no cut.",
      "next_beat_id": "s05_04_pause"
    },
    {
      "type": "wait", "beat_id": "s05_04_pause", "display_name": "5.04 A beat",
      "duration_seconds": 1.5,
      "next_beat_id": "s05_04_line2"
    },
    {
      "type": "dialogue", "beat_id": "s05_04_line2", "display_name": "5.04 'Because my mother didn't break.'",
      "dialogue_id": "nsb_s05_pure_03", "speaker_actor_id": "pure",
      "timeout_seconds": 14.0,
      "note": "\"She worked three jobs. Her back was shot. She never complained once... she decided it wasn't going to be the thing that stopped her.\"",
      "next_beat_id": "s05_04_line3"
    },
    {
      "type": "dialogue", "beat_id": "s05_04_line3", "display_name": "5.04 'So I won't either.'",
      "dialogue_id": "nsb_s05_pure_04", "speaker_actor_id": "pure",
      "timeout_seconds": 6.0,
      "note": "Quieter. By the end of this speech his posture is taller than when he sat down. Not vindicated -- decided.",
      "next_beat_id": "s05_05_cam"
