    {
      "type": "dialogue", "beat_id": "s01_07_vo", "display_name": "1.07 V.O. 'I learned not to ask where.'",
      "dialogue_id": "nsb_s01_vo_child_01", "speaker_actor_id": "narrator_child",
      "timeout_seconds": 8.0,
      "note": "\"Mom was always already gone when I woke up. I learned not to ask where. I learned to make myself breakfast.\"",
      "next_beat_id": "s01_08_cam"
    },

    {
      "type": "camera", "beat_id": "s01_08_cam", "display_name": "1.08 Breakfast alone, wide",
