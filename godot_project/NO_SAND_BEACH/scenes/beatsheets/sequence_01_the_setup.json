    {
      "type": "dialogue", "beat_id": "s01_10_vo", "display_name": "1.10 V.O. 'I had to be perfect.'",
      "dialogue_id": "nsb_s01_marcus_vo_02", "speaker_actor_id": "marcus",
      "timeout_seconds": 14.0,
      "note": "\"I did everything right... He can fail and she'll still love him... Me? I had to be perfect.\" This line is the seed Sequence 4's hospital confrontation pays off.",
      "next_beat_id": "s01_11_cam"
    },

    {
      "type": "camera", "beat_id": "s01_11_cam", "display_name": "1.11 Wide -- Marcus at the counter",
