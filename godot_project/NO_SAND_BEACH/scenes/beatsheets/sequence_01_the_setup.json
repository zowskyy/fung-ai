      "type": "dialogue", "beat_id": "s01_09_line2", "display_name": "1.09 'I know.'",
      "dialogue_id": "nsb_s01_pure_01", "speaker_actor_id": "pure", "target_actor_id": "marcus",
      "timeout_seconds": 4.0,
      "next_beat_id": "s01_09_line3"
    },
    {
      "type": "dialogue", "beat_id": "s01_09_line3", "display_name": "1.09 'Did Mom leave money for lunch?'",
      "dialogue_id": "nsb_s01_marcus_02", "speaker_actor_id": "marcus", "target_actor_id": "pure",
      "timeout_seconds": 5.0,
      "next_beat_id": "s01_09_line4"
    },
    {
      "type": "dialogue", "beat_id": "s01_09_line4", "display_name": "1.09 'Yeah. On the counter.'",
      "dialogue_id": "nsb_s01_pure_02", "speaker_actor_id": "pure", "target_actor_id": "marcus",
      "timeout_seconds": 4.0,
      "next_beat_id": "s01_09_vo"
    },
    {
      "type": "dialogue", "beat_id": "s01_09_vo", "display_name": "1.09 V.O. 'He shouldn't have to know about money yet.'",
      "dialogue_id": "nsb_s01_marcus_vo_01", "speaker_actor_id": "marcus",
      "timeout_seconds": 10.0,
      "note": "Internal. \"He shouldn't have to know she's not coming back today.\"",
