    {
      "type": "dialogue", "beat_id": "s01_11_line1", "display_name": "1.11 'If Mom calls, tell her I came by.'",
      "dialogue_id": "nsb_s01_marcus_03", "speaker_actor_id": "marcus", "target_actor_id": "pure",
      "timeout_seconds": 5.0,
