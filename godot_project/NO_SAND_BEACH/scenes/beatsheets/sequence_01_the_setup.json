      "type": "dialogue", "beat_id": "s01_11_line2", "display_name": "1.11 'Okay.'",
      "dialogue_id": "nsb_s01_pure_03", "speaker_actor_id": "pure", "target_actor_id": "marcus",
      "timeout_seconds": 3.0,
      "next_beat_id": "s01_11_line3"
    },
    {
      "type": "dialogue", "beat_id": "s01_11_line3", "display_name": "1.11 'She won't remember I was even here.'",
      "dialogue_id": "nsb_s01_marcus_vo_03", "speaker_actor_id": "marcus",
      "timeout_seconds": 6.0,
      "note": "Muttered, half-internal.",
