    {
      "type": "dialogue", "beat_id": "s01_06_vo", "display_name": "1.06 V.O. 'She never stopped.'",
      "dialogue_id": "nsb_s01_vo_01", "speaker_actor_id": "narrator",
      "timeout_seconds": 10.0,
      "note": "Adult Pure, retrospective: \"Her knees ached. Her back was shot. But she never stopped.\"",
