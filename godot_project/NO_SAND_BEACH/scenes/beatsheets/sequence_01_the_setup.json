    {
      "type": "dialogue", "beat_id": "s01_14_vo", "display_name": "1.14 V.O. 'Seventeen dollars in his pocket.'",
      "dialogue_id": "nsb_s01_vo_02", "speaker_actor_id": "narrator",
      "timeout_seconds": 16.0,
      "note": "\"He loved us. He loved the street more. I spent my whole life trying to prove he was wrong about that -- that you could love both.\"",
      "next_beat_id": "s01_15_cam"
    },

    {
      "type": "camera", "beat_id": "s01_15_cam", "display_name": "1.15 Back to school, present -- Pure's face",
