    {
      "type": "dialogue", "beat_id": "s01_16_vo", "display_name": "1.16 V.O. 'We just never looked down.'",
      "dialogue_id": "nsb_s01_vo_04", "speaker_actor_id": "narrator",
      "timeout_seconds": 14.0,
      "note": "\"The ocean was there. It was always there. We just never looked down to see the ground we were standing on.\" Sets up the closing narration of Sequence 6.",
