[sub_resource type="Resource" id="Resource_beat_s01_07_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_07_vo"
display_name = "1.07 V.O. 'I learned not to ask where.'"
next_beat_id = &"s01_08_cam"
note = "\"Mom was always already gone when I woke up. I learned not to ask where. I learned to make myself breakfast.\""
dialogue_id = &"nsb_s01_vo_child_01"
speaker_actor_id = &"narrator_child"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s01_08_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_08_cam"
display_name = "1.08 Breakfast alone, wide"
next_beat_id = &"s01_08_eat"
note = "The kitchen scaled to make one kid at a table look small."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_08_eat"]
script = ExtResource("4_action")
beat_id = &"s01_08_eat"
display_name = "1.08 Pure eats alone"
next_beat_id = &"s01_08_vo"
actor_id = &"pure"
action_id = &"eat"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s01_08_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_08_vo"
display_name = "1.08 V.O. 'I didn't know it was supposed to be different.'"
next_beat_id = &"s01_09_enter"
dialogue_id = &"nsb_s01_vo_child_02"
speaker_actor_id = &"narrator_child"
timeout_seconds = 12.0

