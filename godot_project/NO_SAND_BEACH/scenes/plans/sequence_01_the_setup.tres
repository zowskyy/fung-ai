blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_03_coffee"]
script = ExtResource("4_action")
beat_id = &"s01_03_coffee"
display_name = "1.03 Coffee machine"
next_beat_id = &"s01_03_vo"
actor_id = &"delia"
action_id = &"pour_coffee"
wait_for_completion = true
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s01_03_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_03_vo"
display_name = "1.03 V.O. 'No time. Never time.'"
next_beat_id = &"s01_04_change"
note = "\"No time. Never time. Just make it to 6 AM.\""
dialogue_id = &"nsb_s01_delia_vo_03"
speaker_actor_id = &"delia"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s01_04_change"]
script = ExtResource("4_action")
beat_id = &"s01_04_change"
display_name = "1.04 The uniform change"
next_beat_id = &"s01_04_vo"
note = "Home health aide out, hotel housekeeper in. Three jobs made visible as costume."
actor_id = &"delia"
action_id = &"change_clothes"
wait_for_completion = true
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s01_04_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_04_vo"
display_name = "1.04 V.O. 'Just keep moving.'"
next_beat_id = &"s01_05_cam"
note = "\"Hilton pays better. Hotel housekeeper, 6 to 2. Then cafeteria at 3. Just keep moving.\""
dialogue_id = &"nsb_s01_delia_vo_04"
speaker_actor_id = &"delia"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s01_05_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_05_cam"
display_name = "1.05 The door again -- rhymes with 1.01"
next_beat_id = &"s01_05_vo"
note = "Same framing as her return. Three hours later she's leaving again."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_05_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_05_vo"
display_name = "1.05 V.O. 'I love you so much it scares me.'"
next_beat_id = &"s01_05_exit"
dialogue_id = &"nsb_s01_delia_vo_05"
speaker_actor_id = &"delia"
target_actor_id = &"pure"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s01_05_exit"]
script = ExtResource("4_action")
beat_id = &"s01_05_exit"
display_name = "1.05 The departure"
next_beat_id = &"s01_06_cam"
