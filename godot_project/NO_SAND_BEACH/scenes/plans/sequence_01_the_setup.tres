[sub_resource type="Resource" id="Resource_beat_s01_09_line2"]
script = ExtResource("5_dialogue")
beat_id = &"s01_09_line2"
display_name = "1.09 'I know.'"
next_beat_id = &"s01_09_line3"
dialogue_id = &"nsb_s01_pure_01"
speaker_actor_id = &"pure"
target_actor_id = &"marcus"
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s01_09_line3"]
script = ExtResource("5_dialogue")
beat_id = &"s01_09_line3"
display_name = "1.09 'Did Mom leave money for lunch?'"
next_beat_id = &"s01_09_line4"
dialogue_id = &"nsb_s01_marcus_02"
speaker_actor_id = &"marcus"
target_actor_id = &"pure"
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s01_09_line4"]
script = ExtResource("5_dialogue")
beat_id = &"s01_09_line4"
display_name = "1.09 'Yeah. On the counter.'"
next_beat_id = &"s01_09_vo"
dialogue_id = &"nsb_s01_pure_02"
speaker_actor_id = &"pure"
target_actor_id = &"marcus"
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s01_09_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_09_vo"
display_name = "1.09 V.O. 'He shouldn't have to know about money yet.'"
next_beat_id = &"s01_10_cam"
note = "Internal. \"He shouldn't have to know she's not coming back today.\""
dialogue_id = &"nsb_s01_marcus_vo_01"
speaker_actor_id = &"marcus"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s01_10_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_10_cam"
display_name = "1.10 Close on Marcus"
next_beat_id = &"s01_10_vo"
note = "Silent beat. The resentment is entirely on his face and in the V.O."
camera_mode_id = &"close_hold"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_10_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_10_vo"
display_name = "1.10 V.O. 'I had to be perfect.'"
next_beat_id = &"s01_11_cam"
note = "\"I did everything right... He can fail and she'll still love him... Me? I had to be perfect.\" This line is the seed Sequence 4's hospital confrontation pays off."
dialogue_id = &"nsb_s01_marcus_vo_02"
speaker_actor_id = &"marcus"
timeout_seconds = 14.0

[sub_resource type="Resource" id="Resource_beat_s01_11_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_11_cam"
display_name = "1.11 Wide -- Marcus at the counter"
next_beat_id = &"s01_11_money"
note = "His sacrifice made visible: he's adding his own money to what Delia left."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_11_money"]
script = ExtResource("4_action")
beat_id = &"s01_11_money"
display_name = "1.11 Marcus adds lunch money"
next_beat_id = &"s01_11_line1"
note = "Care masked as obligation. He will never say what this is."
actor_id = &"marcus"
action_id = &"set_down"
wait_for_completion = true
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s01_11_line1"]
script = ExtResource("5_dialogue")
beat_id = &"s01_11_line1"
display_name = "1.11 'If Mom calls, tell her I came by.'"
next_beat_id = &"s01_11_line2"
dialogue_id = &"nsb_s01_marcus_03"
speaker_actor_id = &"marcus"
target_actor_id = &"pure"
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s01_11_line2"]
script = ExtResource("5_dialogue")
beat_id = &"s01_11_line2"
display_name = "1.11 'Okay.'"
next_beat_id = &"s01_11_line3"
dialogue_id = &"nsb_s01_pure_03"
speaker_actor_id = &"pure"
target_actor_id = &"marcus"
timeout_seconds = 3.0

[sub_resource type="Resource" id="Resource_beat_s01_11_line3"]
script = ExtResource("5_dialogue")
beat_id = &"s01_11_line3"
display_name = "1.11 'She won't remember I was even here.'"
next_beat_id = &"s01_12_exit"
note = "Muttered, half-internal."
dialogue_id = &"nsb_s01_marcus_vo_03"
speaker_actor_id = &"marcus"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s01_12_exit"]
script = ExtResource("4_action")
beat_id = &"s01_12_exit"
display_name = "1.12 Marcus leaves"
next_beat_id = &"s01_12_vo"
actor_id = &"marcus"
action_id = &"exit"
wait_for_completion = true
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s01_12_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_12_vo"
display_name = "1.12 V.O. 'Like everyone.'"
next_beat_id = &"s01_13_cam"
note = "\"I didn't know my brother was angry at me. I didn't know he was giving me his lunch money. I just knew he was always leaving. Like everyone.\""
dialogue_id = &"nsb_s01_vo_child_03"
speaker_actor_id = &"narrator_child"
timeout_seconds = 12.0

[sub_resource type="Resource" id="Resource_beat_s01_13_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_13_cam"
display_name = "1.13 School bench, wide -- Pure isolated"
next_beat_id = &"s01_13_talk_a"
note = "Three kids on a bench, Pure isolated in the frame despite being among them."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_13_talk_a"]
script = ExtResource("5_dialogue")
beat_id = &"s01_13_talk_a"
display_name = "1.13 Classmates on the beach"
next_beat_id = &"s01_13_talk_b"
note = "Casual weekend-at-the-beach chatter. Joy and privilege, entirely unaware."
dialogue_id = &"nsb_s01_classmate_01"
speaker_actor_id = &"classmate_a"
target_actor_id = &"classmate_b"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s01_13_talk_b"]
script = ExtResource("5_dialogue")
beat_id = &"s01_13_talk_b"
display_name = "1.13 The other classmate answers"
next_beat_id = &"s01_13_listen"
note = "The exchange has to be between the two of them, not delivered at Pure -- the point is that he is not in the conversation at all."
dialogue_id = &"nsb_s01_classmate_02"
speaker_actor_id = &"classmate_b"
target_actor_id = &"classmate_a"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s01_13_listen"]
script = ExtResource("4_action")
beat_id = &"s01_13_listen"
display_name = "1.13 Pure listens, not included"
next_beat_id = &"s01_13_face"
note = "He is on the same bench and outside the conversation. Isolation staged, not stated."
actor_id = &"pure"
action_id = &"listen"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s01_13_face"]
script = ExtResource("3_camera")
beat_id = &"s01_13_face"
display_name = "1.13 Close -- Pure learning shame"
next_beat_id = &"s01_13_vo"
camera_mode_id = &"close_hold"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_13_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_13_vo"
display_name = "1.13 V.O. 'The beach was for people who owned houses.'"
next_beat_id = &"s01_14_cam"
note = "\"The ocean was ten miles away. I could smell it sometimes -- salt and seaweed on the wind. But it wasn't for us.\""
dialogue_id = &"nsb_s01_pure_vo_01"
speaker_actor_id = &"narrator"
timeout_seconds = 14.0

[sub_resource type="Resource" id="Resource_beat_s01_14_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_14_cam"
display_name = "1.14 Wavy transition into memory"
next_beat_id = &"s01_14_hold_child"
note = "EARL'S GHOST. M2S period styling starts here and ends when the beat does -- the only period-styled beat in Sequence 1."
camera_mode_id = &"slow_push"
blend_seconds = 2.0

[sub_resource type="Resource" id="Resource_beat_s01_14_hold_child"]
script = ExtResource("4_action")
beat_id = &"s01_14_hold_child"
display_name = "1.14 Earl kneels and holds Pure (7)"
next_beat_id = &"s01_14_held"
note = "Warm, soft-focus, tender. Earl's memory design, period wardrobe."
actor_id = &"earl"
action_id = &"hold_child"
wait_for_completion = true
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s01_14_held"]
script = ExtResource("4_action")
beat_id = &"s01_14_held"
display_name = "1.14 Pure (7) held in his father's arms"
next_beat_id = &"s01_14_line"
note = "The age-7 design's only appearance in the film -- it needs its own clip, since Earl's hold_child animates only Earl. This is the last time Pure is held by anyone until Marcus's hug in 4.05."
actor_id = &"pure_child"
action_id = &"be_held"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s01_14_line"]
script = ExtResource("5_dialogue")
beat_id = &"s01_14_line"
display_name = "1.14 Earl's promise"
next_beat_id = &"s01_14_vanish"
dialogue_id = &"nsb_s01_earl_01"
speaker_actor_id = &"earl"
target_actor_id = &"pure_child"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s01_14_vanish"]
script = ExtResource("4_action")
beat_id = &"s01_14_vanish"
display_name = "1.14 Earl vanishes"
next_beat_id = &"s01_14_vo"
actor_id = &"earl"
action_id = &"vanish"
wait_for_completion = true
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s01_14_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_14_vo"
display_name = "1.14 V.O. 'Seventeen dollars in his pocket.'"
next_beat_id = &"s01_15_cam"
note = "\"He loved us. He loved the street more. I spent my whole life trying to prove he was wrong about that -- that you could love both.\""
dialogue_id = &"nsb_s01_vo_02"
speaker_actor_id = &"narrator"
timeout_seconds = 16.0

[sub_resource type="Resource" id="Resource_beat_s01_15_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_15_cam"
display_name = "1.15 Back to school, present -- Pure's face"
next_beat_id = &"s01_15_vo"
note = "Present, haunted. The transition back out of the memory."
camera_mode_id = &"close_hold"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s01_15_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_15_vo"
display_name = "1.15 V.O. 'Love and failure.'"
next_beat_id = &"s01_16_cam"
note = "\"That pattern haunted me my whole life... I carried his seventeen dollars like they were gold.\""
dialogue_id = &"nsb_s01_vo_03"
speaker_actor_id = &"narrator"
timeout_seconds = 12.0

[sub_resource type="Resource" id="Resource_beat_s01_16_cam"]
