[sub_resource type="Resource" id="Resource_beat_s01_01_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_01_cam"
display_name = "1.01 Apartment door, 3AM"
next_beat_id = &"s01_01_enter"
note = "Delia comes home at 3AM. The apartment is dark except one lamp."
camera_mode_id = &"wide_static"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s01_01_enter"]
script = ExtResource("4_action")
beat_id = &"s01_01_enter"
display_name = "1.01 Delia returns"
next_beat_id = &"s01_01_vo"
note = "Exhaustion carried in the body, not performed on the face."
actor_id = &"delia"
action_id = &"enter"
wait_for_completion = true
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s01_01_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_01_vo"
display_name = "1.01 V.O. 'Twenty-three clients today.'"
next_beat_id = &"s01_02_cam"
note = "Internal monologue -- the day's ledger. \"...Still got to do Hilton prep at 6.\""
dialogue_id = &"nsb_s01_delia_vo_01"
speaker_actor_id = &"delia"
timeout_seconds = 14.0

[sub_resource type="Resource" id="Resource_beat_s01_02_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_02_cam"
display_name = "1.02 Pure's room, close"
next_beat_id = &"s01_02_sleep"
camera_mode_id = &"close_hold"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s01_02_sleep"]
script = ExtResource("4_action")
beat_id = &"s01_02_sleep"
display_name = "1.02 Pure asleep"
next_beat_id = &"s01_02_kiss"
actor_id = &"pure"
action_id = &"sleep"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s01_02_kiss"]
script = ExtResource("4_action")
beat_id = &"s01_02_kiss"
display_name = "1.02 THE RITUAL -- forehead kiss"
next_beat_id = &"s01_02_vo"
note = "The tenderness she has no time to show him awake."
actor_id = &"delia"
action_id = &"kiss_forehead"
wait_for_completion = true
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s01_02_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_02_vo"
display_name = "1.02 V.O. 'You're gonna make it, baby.'"
next_beat_id = &"s01_03_cam"
note = "\"You're gonna have better than this. Better than me.\""
dialogue_id = &"nsb_s01_delia_vo_02"
speaker_actor_id = &"delia"
target_actor_id = &"pure"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s01_03_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_03_cam"
display_name = "1.03 Kitchen, medium"
next_beat_id = &"s01_03_coffee"
