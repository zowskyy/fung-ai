beat_id = &"s01_16_cam"
display_name = "1.16 Evening -- the ocean unseen"
next_beat_id = &"s01_16_vo"
note = "Aerial Santa Ana at sunset. The ocean is in frame and unreachable. No actor on screen."
camera_mode_id = &"wide_static"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s01_16_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_16_vo"
display_name = "1.16 V.O. 'We just never looked down.'"
next_beat_id = &"s01_16_hold"
note = "\"The ocean was there. It was always there. We just never looked down to see the ground we were standing on.\" Sets up the closing narration of Sequence 6."
dialogue_id = &"nsb_s01_vo_04"
speaker_actor_id = &"narrator"
timeout_seconds = 14.0

