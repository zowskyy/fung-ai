[sub_resource type="Resource" id="Resource_beat_s01_06_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_06_cam"
display_name = "1.06 The empty apartment"
next_beat_id = &"s01_06_vo"
note = "No actor on screen. The apartment holds her absence."
camera_mode_id = &"wide_static"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s01_06_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s01_06_vo"
display_name = "1.06 V.O. 'She never stopped.'"
next_beat_id = &"s01_07_wake"
note = "Adult Pure, retrospective: \"Her knees ached. Her back was shot. But she never stopped.\""
dialogue_id = &"nsb_s01_vo_01"
speaker_actor_id = &"narrator"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s01_07_wake"]
script = ExtResource("4_action")
beat_id = &"s01_07_wake"
display_name = "1.07 Pure wakes alone"
