[sub_resource type="Resource" id="Resource_beat_s01_09_cam"]
script = ExtResource("3_camera")
beat_id = &"s01_09_cam"
display_name = "1.09 Two-shot, brothers"
next_beat_id = &"s01_09_line1"
camera_mode_id = &"two_shot"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s01_09_line1"]
script = ExtResource("5_dialogue")
beat_id = &"s01_09_line1"
display_name = "1.09 'Pure, it's 7:15.'"
next_beat_id = &"s01_09_line2"
