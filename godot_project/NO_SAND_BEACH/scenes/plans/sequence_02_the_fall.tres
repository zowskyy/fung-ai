[sub_resource type="Resource" id="Resource_beat_s02_01_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_01_cam"
display_name = "2.01 Street corner, night, red/blue strobe"
next_beat_id = &"s02_01_cuffed"
note = "Deliberately undramatic. No chase, no fight -- this is already routine to him."
camera_mode_id = &"wide_static"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_01_cuffed"]
script = ExtResource("4_action")
beat_id = &"s02_01_cuffed"
display_name = "2.01 THE FIRST ARREST -- age 15"
next_beat_id = &"s02_01_push"
note = "Flat, practiced stillness. He doesn't struggle, doesn't cry. Remember this staging -- beat 2.04 echoes it exactly."
actor_id = &"pure_teen"
action_id = &"cuffed"
wait_for_completion = true
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s02_01_push"]
script = ExtResource("3_camera")
beat_id = &"s02_01_push"
display_name = "2.01 Push to his face"
next_beat_id = &"s02_01_vo"
note = "Unreadable, resigned."
camera_mode_id = &"slow_push"
blend_seconds = 2.0

[sub_resource type="Resource" id="Resource_beat_s02_01_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_01_vo"
display_name = "2.01 V.O. 'First time, I was fifteen.'"
next_beat_id = &"s02_02_cam"
note = "\"Wasn't the last time. Wasn't even close to the worst time.\""
dialogue_id = &"nsb_s02_vo_01"
speaker_actor_id = &"narrator"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_02_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_02_cam"
display_name = "2.02 THE PATTERN -- flash montage"
next_beat_id = &"s02_02_vo"
note = "Four flash images, each barely a beat: empty courtroom bench, probation waiting room, calendar page, night bus stop. Hard cuts, no movement within each -- deliberately choppy and list-like."
camera_mode_id = &"insert"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_02_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_02_vo"
display_name = "2.02 V.O. 'My name already meant something.'"
next_beat_id = &"s02_03_cam"
note = "\"...By twenty-one, my name already meant something to people who'd never met me.\" Carries continuously across the cuts."
dialogue_id = &"nsb_s02_vo_02"
speaker_actor_id = &"narrator"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s02_03_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_03_cam"
display_name = "2.03 Storefront exterior, day"
next_beat_id = &"s02_03_walk"
note = "Staging must make the wrongness readable without dialogue: Pure is visibly, spatially not the source of the commotion, and it doesn't matter."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_03_walk"]
script = ExtResource("6_move_to")
beat_id = &"s02_03_walk"
display_name = "2.03 WRONG PLACE -- Pure walking"
next_beat_id = &"s02_03_line1"
note = "Unhurried, minding his own path. Commotion breaks out ahead -- not his doing, barely his proximity."
actor_id = &"pure"
arrival_radius = 0.5
locomotion_mode = "walk"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s02_03_line1"]
script = ExtResource("5_dialogue")
beat_id = &"s02_03_line1"
display_name = "2.03 'Don't move!'"
next_beat_id = &"s02_03_line2"
dialogue_id = &"nsb_s02_officer_01"
speaker_actor_id = &"officer"
target_actor_id = &"pure"
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s02_03_line2"]
script = ExtResource("5_dialogue")
beat_id = &"s02_03_line2"
display_name = "2.03 'I didn't-- I wasn't even--'"
next_beat_id = &"s02_03_line3"
dialogue_id = &"nsb_s02_pure_01"
speaker_actor_id = &"pure"
target_actor_id = &"officer"
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s02_03_line3"]
script = ExtResource("5_dialogue")
beat_id = &"s02_03_line3"
display_name = "2.03 'Hands where I can see them.'"
next_beat_id = &"s02_04_cam"
dialogue_id = &"nsb_s02_officer_02"
speaker_actor_id = &"officer"
target_actor_id = &"pure"
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s02_04_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_04_cam"
display_name = "2.04 Echo 2.01's framing exactly"
next_beat_id = &"s02_04_cuffed"
note = "Deliberate visual echo of the teen arrest -- same posture, same wall-lean, same cuff-click. The repetition is the meaning."
camera_mode_id = &"wide_static"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_04_cuffed"]
script = ExtResource("4_action")
beat_id = &"s02_04_cuffed"
display_name = "2.04 THIS ONE STICKS"
next_beat_id = &"s02_04_break"
note = "Unlike 2.01's flatness, his face here shows the moment he understands: this is the one that doesn't wash off."
actor_id = &"pure"
action_id = &"cuffed"
wait_for_completion = true
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s02_04_break"]
script = ExtResource("3_camera")
beat_id = &"s02_04_break"
display_name = "2.04 Break from the echo -- hold his face"
next_beat_id = &"s02_04_vo"
note = "No rage, no protest theatrics. Just the specific weight of an unjust world closing a door."
camera_mode_id = &"close_hold"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_04_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_04_vo"
display_name = "2.04 V.O. 'And I didn't even do it.'"
next_beat_id = &"s02_05_cam"
dialogue_id = &"nsb_s02_vo_03"
speaker_actor_id = &"narrator"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_05_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_05_cam"
display_name = "2.05 Courtroom wide, sparse"
next_beat_id = &"s02_05_line"
note = "Not a trial drama -- a single decisive image. Same courtroom environment Sequence 5 reuses."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_05_line"]
script = ExtResource("5_dialogue")
beat_id = &"s02_05_line"
display_name = "2.05 'Ten years.'"
next_beat_id = &"s02_05_gavel"
dialogue_id = &"nsb_s02_judge_01"
speaker_actor_id = &"judge"
target_actor_id = &"pure"
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s02_05_gavel"]
script = ExtResource("4_action")
beat_id = &"s02_05_gavel"
display_name = "2.05 Gavel"
next_beat_id = &"s02_05_face"
note = "Sharp, final, then a hard cut to silence."
actor_id = &"judge"
action_id = &"gavel"
wait_for_completion = true
timeout_seconds = 2.0

[sub_resource type="Resource" id="Resource_beat_s02_05_face"]
script = ExtResource("3_camera")
beat_id = &"s02_05_face"
display_name = "2.05 Close on Pure, unmoving"
next_beat_id = &"s02_05_vo"
camera_mode_id = &"close_hold"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_05_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_05_vo"
display_name = "2.05 V.O. 'For something I never touched.'"
next_beat_id = &"s02_06_cam"
dialogue_id = &"nsb_s02_vo_04"
speaker_actor_id = &"narrator"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s02_06_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_06_cam"
display_name = "2.06 THE CELL -- static, held"
next_beat_id = &"s02_06_sit"
note = "No camera movement. The stillness itself is the image. The sequence's visual low point."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_06_sit"]
script = ExtResource("4_action")
beat_id = &"s02_06_sit"
display_name = "2.06 Pure sits, doesn't move"
next_beat_id = &"s02_06_vo"
actor_id = &"pure"
action_id = &"sit_still"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_06_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_06_vo"
display_name = "2.06 V.O. 'A long time to sit with what you didn't do.'"
next_beat_id = &"s02_06_hold"
dialogue_id = &"nsb_s02_vo_05"
speaker_actor_id = &"narrator"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_06_hold"]
script = ExtResource("7_wait")
beat_id = &"s02_06_hold"
display_name = "2.06 Hold the stillness"
next_beat_id = &"s02_07_cam"
duration_seconds = 3.0

[sub_resource type="Resource" id="Resource_beat_s02_07_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_07_cam"
display_name = "2.07 Prison library, wide"
next_beat_id = &"s02_07_approach"
note = "Mostly empty, fluorescent. This location rhymes forward to Sequence 6's coding classroom."
camera_mode_id = &"wide_static"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_07_approach"]
script = ExtResource("6_move_to")
beat_id = &"s02_07_approach"
display_name = "2.07 THE BROKEN COMPUTER"
next_beat_id = &"s02_07_insert"
note = "Approaches it like it's nothing, almost by accident -- then something catches."
actor_id = &"pure"
arrival_radius = 0.4
locomotion_mode = "walk"
timeout_seconds = 6.0

[sub_resource type="Resource" id="Resource_beat_s02_07_insert"]
script = ExtResource("3_camera")
beat_id = &"s02_07_insert"
display_name = "2.07 Close -- his hands, the screen glow"
next_beat_id = &"s02_07_type"
note = "The screen glow is the first non-institutional light in the sequence. A deliberate visual turn."
camera_mode_id = &"insert"
blend_seconds = 2.0

[sub_resource type="Resource" id="Resource_beat_s02_07_type"]
script = ExtResource("4_action")
beat_id = &"s02_07_type"
display_name = "2.07 Testing what still works"
next_beat_id = &"s02_07_vo"
note = "Uneven, testing. Contrast with the confident typing of 2.08 and Sequence 3."
actor_id = &"pure"
action_id = &"type"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_07_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_07_vo"
display_name = "2.07 V.O. 'The first thing in years that did exactly what I told it to.'"
next_beat_id = &"s02_08_cam"
dialogue_id = &"nsb_s02_vo_06"
speaker_actor_id = &"narrator"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s02_08_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_08_cam"
display_name = "2.08 THE CODE OBEYS -- montage"
next_beat_id = &"s02_08_read"
note = "Tight cuts building rhythm: hands on keys, pages of notes, screen text, his face lit by the monitor. The sequence's emotional pivot."
camera_mode_id = &"insert"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_08_read"]
script = ExtResource("4_action")
beat_id = &"s02_08_read"
display_name = "2.08 Library books, scribbled notes"
next_beat_id = &"s02_08_type"
actor_id = &"pure"
action_id = &"read"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_08_type"]
script = ExtResource("4_action")
beat_id = &"s02_08_type"
display_name = "2.08 Increasingly confident typing"
next_beat_id = &"s02_08_vo"
note = "Posture changes across the montage -- hunched and uncertain to upright and focused."
actor_id = &"pure"
action_id = &"type"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_08_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_08_vo"
display_name = "2.08 V.O. 'The code obeyed. The world never had.'"
next_beat_id = &"s02_09_cam"
note = "\"...no appeal, no jury, no lie. That was the first time I felt like I had any control over anything.\""
dialogue_id = &"nsb_s02_vo_07"
speaker_actor_id = &"narrator"
timeout_seconds = 20.0

[sub_resource type="Resource" id="Resource_beat_s02_09_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_09_cam"
display_name = "2.09 TEN YEARS -- the repeated window"
next_beat_id = &"s02_09_hold"
note = "TIME-COMPRESSION DEVICE: identical locked-off framing of the cell window, only the light changes, season to season, several times. Keep the framing byte-identical so only light reads as different -- that is what makes the years legible without a calendar graphic."
camera_mode_id = &"wide_static"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_09_hold"]
script = ExtResource("7_wait")
beat_id = &"s02_09_hold"
display_name = "2.09 The window, repeating"
next_beat_id = &"s02_09_close"
note = "Intercut with the library computer, Pure visibly more capable each time we return to it."
duration_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_09_close"]
script = ExtResource("4_action")
beat_id = &"s02_09_close"
display_name = "2.09 Closes a notebook full of code"
next_beat_id = &"s02_09_vo"
note = "Final image of the montage: older, steadier, ready."
actor_id = &"pure"
action_id = &"close_laptop"
wait_for_completion = true
timeout_seconds = 4.0

[sub_resource type="Resource" id="Resource_beat_s02_09_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_09_vo"
display_name = "2.09 V.O. 'I came out knowing exactly what I could build.'"
next_beat_id = &"s02_10_cam"
note = "V.O. only, no other sound -- deliberate quiet to let the passage of time land."
dialogue_id = &"nsb_s02_vo_08"
speaker_actor_id = &"narrator"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s02_10_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_10_cam"
display_name = "2.10 THE GATE -- STYLE PIVOT"
next_beat_id = &"s02_10_walk"
note = "THE SEQUENCE'S BIGGEST TECHNIQUE MOMENT: M2S period styling ends here and contemporary begins. The light itself should feel like a style change, not just a lighting change."
camera_mode_id = &"wide_static"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s02_10_walk"]
script = ExtResource("6_move_to")
beat_id = &"s02_10_walk"
display_name = "2.10 Pure steps through the gate"
next_beat_id = &"s02_10_face"
note = "Stops just past the threshold, looks back once, then forward."
actor_id = &"pure"
arrival_radius = 0.5
locomotion_mode = "walk"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_10_face"]
script = ExtResource("3_camera")
beat_id = &"s02_10_face"
display_name = "2.10 Close -- squinting into the light"
next_beat_id = &"s02_10_vo"
note = "Something like hope. First genuinely bright open exterior in the sequence."
camera_mode_id = &"close_hold"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s02_10_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_10_vo"
display_name = "2.10 V.O. 'I walked out thinking the hard part was over.'"
next_beat_id = &"s02_11_cam"
dialogue_id = &"nsb_s02_vo_09"
speaker_actor_id = &"narrator"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_11_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_11_cam"
display_name = "2.11 Interview two-shot, warm"
next_beat_id = &"s02_11_sit"
note = "First fully contemporary interior. Clean, bright, ordinary office banality -- which makes the rejection land colder against the prison's visual weight."
camera_mode_id = &"two_shot"
blend_seconds = 0.5

[sub_resource type="Resource" id="Resource_beat_s02_11_sit"]
script = ExtResource("4_action")
beat_id = &"s02_11_sit"
display_name = "2.11 Pure engaged, leaning forward"
next_beat_id = &"s02_11_line1"
actor_id = &"pure"
action_id = &"sit_still"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_11_line1"]
script = ExtResource("5_dialogue")
beat_id = &"s02_11_line1"
display_name = "2.11 'This all looks great, Pure--- oh.'"
next_beat_id = &"s02_11_folder"
note = "The pause mid-sentence is the beat: their eyes drop to the page and the warmth drains out."
dialogue_id = &"nsb_s02_interviewer_01"
speaker_actor_id = &"interviewer"
target_actor_id = &"pure"
timeout_seconds = 8.0

[sub_resource type="Resource" id="Resource_beat_s02_11_folder"]
script = ExtResource("3_camera")
beat_id = &"s02_11_folder"
display_name = "2.11 Insert: the folder page"
next_beat_id = &"s02_11_line2"
note = "Background-check result implied, never shown in detail."
camera_mode_id = &"insert"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_11_line2"]
script = ExtResource("5_dialogue")
beat_id = &"s02_11_line2"
display_name = "2.11 'I can explain that.'"
next_beat_id = &"s02_11_line3"
dialogue_id = &"nsb_s02_pure_02"
speaker_actor_id = &"pure"
target_actor_id = &"interviewer"
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s02_11_line3"]
script = ExtResource("5_dialogue")
beat_id = &"s02_11_line3"
display_name = "2.11 'We'll be in touch.'"
next_beat_id = &"s02_12_cam"
note = "Already retreating into scripted politeness."
dialogue_id = &"nsb_s02_interviewer_02"
speaker_actor_id = &"interviewer"
target_actor_id = &"pure"
timeout_seconds = 5.0

[sub_resource type="Resource" id="Resource_beat_s02_12_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_12_cam"
display_name = "2.12 DOOR AFTER DOOR -- rhyming coverage"
next_beat_id = &"s02_12_deflate"
note = "Near-identical composition each repetition across different offices. Each room distinct enough to signal 'many', but the human beats interchangeable -- that sameness is the argument."
camera_mode_id = &"two_shot"
blend_seconds = 0.0

[sub_resource type="Resource" id="Resource_beat_s02_12_deflate"]
script = ExtResource("4_action")
beat_id = &"s02_12_deflate"
display_name = "2.12 Posture deflates across the montage"
next_beat_id = &"s02_12_vo"
note = "The confident lean-forward from 2.11 is gone by the final repetition."
actor_id = &"pure"
action_id = &"deflate"
wait_for_completion = true
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s02_12_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_12_vo"
display_name = "2.12 V.O. 'Same page. Same look. Same door.'"
next_beat_id = &"s02_13_cam"
dialogue_id = &"nsb_s02_vo_10"
speaker_actor_id = &"narrator"
timeout_seconds = 10.0

[sub_resource type="Resource" id="Resource_beat_s02_13_cam"]
script = ExtResource("3_camera")
beat_id = &"s02_13_cam"
display_name = "2.13 THE WEIGHT -- wide, isolating"
next_beat_id = &"s02_13_sit"
note = "A bus stop or stairwell -- somewhere transitional and anonymous."
camera_mode_id = &"wide_static"
blend_seconds = 1.0

[sub_resource type="Resource" id="Resource_beat_s02_13_sit"]
script = ExtResource("4_action")
beat_id = &"s02_13_sit"
display_name = "2.13 Sits with the accumulated weight"
next_beat_id = &"s02_13_hands"
actor_id = &"pure"
action_id = &"sit_still"
wait_for_completion = false

[sub_resource type="Resource" id="Resource_beat_s02_13_hands"]
script = ExtResource("3_camera")
beat_id = &"s02_13_hands"
display_name = "2.13 Slow push to his hands"
next_beat_id = &"s02_13_vo"
note = "The same hands that built working code from nothing in a prison library."
camera_mode_id = &"slow_push"
blend_seconds = 3.0

[sub_resource type="Resource" id="Resource_beat_s02_13_vo"]
script = ExtResource("5_dialogue")
beat_id = &"s02_13_vo"
display_name = "2.13 V.O. 'I'd build my own door.'"
next_beat_id = &"s02_13_hold"
note = "\"The code never lied to me. Never looked at a page and changed its mind about me...\" The app's idea is born HERE, in the image -- never stated outright."
dialogue_id = &"nsb_s02_vo_11"
speaker_actor_id = &"narrator"
timeout_seconds = 14.0

[sub_resource type="Resource" id="Resource_beat_s02_13_hold"]
