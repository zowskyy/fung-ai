display_name = "2.13 Hold on the hands"
next_beat_id = &"s02_end"
duration_seconds = 3.0

[sub_resource type="Resource" id="Resource_beat_s02_end"]
script = ExtResource("8_end")
beat_id = &"s02_end"
display_name = "Sequence 2 complete"
note = "Hands off to Sequence 3: The App."
completion_signal = &"scene_finished"

