      "speaker": "boss",
      "text": "Then die!",
      "duration": 1.5
    },
    {
      "id": "flee_start",
      "type": "dialogue",
      "speaker": "boss",
      "text": "Coward!",
      "duration": 1.5
    },
    {
      "id": "outro_wait",
