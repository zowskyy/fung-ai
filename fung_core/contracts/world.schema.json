{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fung.us/schemas/world.schema.json",
  "title": "World",
  "type": "object",
  "required": ["version", "id", "width", "height", "tiles", "spawns"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "tiles": {
      "type": "array",
      "description": "Row-major flattened grid, length must equal width*height. 0=floor, 1=wall.",
      "items": { "type": "integer", "enum": [0, 1] }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "type": { "type": "string", "enum": ["player", "enemy", "boss", "exit", "item"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
