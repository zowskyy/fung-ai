{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fung.us/schemas/narrative.schema.json",
  "title": "NarrativeSequence",
  "type": "object",
  "required": ["version", "sequence_id", "beats"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "sequence_id": { "type": "string", "minLength": 1 },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "beat": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["dialogue", "choice", "branch", "animation_cue", "wait"]
        },
        "speaker": { "type": "string" },
        "text": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "target": { "type": "string" },
        "animation_id": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "next"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "next": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "when": {
          "type": "object",
          "description": "Simple flag/stat condition evaluated for branch beats.",
          "required": ["flag"],
          "properties": {
            "flag": { "type": "string" },
            "equals": {}
          },
          "additionalProperties": false
        },
        "then": { "type": "string" },
        "else": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
